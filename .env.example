# AI worker runtime
AWS_ACCESS_KEY_ID=키
AWS_SECRET_ACCESS_KEY=키
AWS_REGION=ap-northeast-2
SQS_QUEUE_URL=주소
S3_DOWNLOAD_DIR=/tmp/videos
AI_CHUNK_RESULT_DIR=ai/tmp
SAMPLING_FPS=1
RESULT_SINK=rds

# RDS direct result sink
RDS_HOST=DB주소
RDS_PORT=3306
RDS_USER=아이디
RDS_PASSWORD=비밀번호
RDS_DATABASE=DB이름
ANALYSIS_RESULT_TABLE=analysis_summary
ANALYSIS_FEEDBACK_TABLE=analysis_feedback

# Optional tuning
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT_SECONDS=900
BACKEND_POST_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO

# Optional legacy/backend result sink.
# Set RESULT_SINK=post and provide this URL only when HTTP POST is needed.
BACKEND_RESULT_API_URL=주소
